{
  "name": "maths-college-app",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "PWA hors ligne : cours de maths collège (compendium v0.3.1) + exercices générés (chapitres 03, 06, 07, 11)",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dev": "npm run content && vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run content && tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "check": "node scripts/check-dist.mjs",
    "preview": "vite preview --host --port 4173",
    "captures": "node scripts/captures.mjs",
    "test": "tsx tests/answers.test.ts && tsx tests/calc.test.ts && tsx tests/generators.test.ts 2000",
    "test:answers": "tsx tests/answers.test.ts",
    "test:gen": "tsx tests/generators.test.ts 2000",
    "test:nav": "node scripts/test-nav.mjs",
    "test:practice": "tsx scripts/test-practice.mts",
    "sample": "tsx scripts/sample-exercises.mts",
    "test:update": "node scripts/test-update.mjs",
    "test:patrons": "tsx scripts/check-patrons.mts",
    "test:calc": "tsx tests/calc.test.ts",
    "test:calc-e2e": "tsx scripts/test-calc.mts",
    "test:x": "tsx scripts/test-x.mts",
    "test:expr": "tsx scripts/test-expr-e2e.mts",
    "test:order": "tsx scripts/test-order.mts",
    "publish:gh": "bash scripts/publish-gh.sh"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "katex": "^0.18.9",
    "linkedom": "^0.18.13",
    "marked": "^18.1.0",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
